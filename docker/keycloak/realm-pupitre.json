{
  "realm": "pupitre",
  "enabled": true,
  "displayName": "pupitre (démo SSO)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    {
      "name": "Équipe Plateforme"
    },
    {
      "name": "pupitre-managers"
    },
    {
      "name": "pupitre-admins"
    }
  ],
  "clients": [
    {
      "clientId": "pupitre",
      "name": "pupitre",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "pupitre-demo-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/sso/oidc/callback",
        "http://localhost:3100/api/sso/oidc/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3100"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3100/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
