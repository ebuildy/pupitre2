PORT=3001
DATABASE_URL=./data/pupitre.db
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
# BETTER_AUTH_SECRET=
CORS_ORIGINS=http://localhost:3000
LOG_REQUESTS=true
# Admin bootstrap (spec 016). Unset: admin@pupitre.local / Admin@1234 on first start only.
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_FILE=
# Spec 015: mock data (src/fixtures) at startup; `pnpm dev` turns it on unless set in the shell.
# SEED_DEV_DATA=true
# Module content (spec 064): fake = files from content-samples/<repo-name>/<path>; git comes later.
# CONTENT_LOADER=auto   # auto (samples, else git) | git | fake
# GIT_CACHE_DIR=./data/git-cache
# GIT_CACHE_TTL_MINUTES=10
# GIT_CREDENTIALS_PATH=
# GIT_TOKEN=
# CONTENT_SAMPLES_DIR=./content-samples
# Spec 009: sign-in / sign-up attempts per client IP and window (0 disables).
# AUTH_RATE_LIMIT_REQUESTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Client IP header and the proxies to skip in it (add your ingress range in production).
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXIES=127.0.0.1,::1
