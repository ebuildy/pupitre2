{
  "name": "@pupitre/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./auth": "./src/auth.ts"
  },
  "scripts": {
    "dev": "SEED_DEV_DATA=${SEED_DEV_DATA:-true} tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "better-auth generate --config src/auth.ts --output src/db/schema/auth.ts --yes",
    "db:seed": "tsx --env-file-if-exists=.env src/fixtures/cli.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/fixtures/cli.ts --reset"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "auth": "^1.7.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@pupitre/shared": "workspace:*",
    "better-auth": "^1.7.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
