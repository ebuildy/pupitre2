# Defaults for `pnpm dev` only (`.env` and the shell win). Not read by `pnpm start` nor the e2e tests.
# Spec 027, SSO demo: the runtime OIDC provider is the Keycloak of docker/keycloak (`pnpm dev:sso` starts it),
# and the login page's "Comptes de démonstration Keycloak" buttons sign in through it in one click.
OIDC_ENABLED=true
OIDC_NAME=Keycloak
OIDC_PROVIDER_URL=http://localhost:8180/realms/pupitre
OIDC_CLIENT_ID=pupitre
OIDC_CLIENT_SECRET=pupitre-demo-secret
# The realm has no `groups` scope: its client mapper puts the groups in every token.
OIDC_SCOPES=openid email profile
SSO_DEMO_PASSWORD_GRANT=true
