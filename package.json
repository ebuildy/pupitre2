{
  "name": "pupitre",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pupitre/api --filter @pupitre/app --filter @pupitre/admin dev",
    "dev:sso": "sh docker/keycloak/dev-sso.sh",
    "sso:down": "docker compose -f docker/keycloak/compose.yaml down",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @pupitre/api db:generate",
    "db:migrate": "pnpm --filter @pupitre/api db:migrate",
    "db:seed": "pnpm --filter @pupitre/api db:seed",
    "db:reset": "pnpm --filter @pupitre/api db:reset",
    "auth:generate": "pnpm --filter @pupitre/api auth:generate",
    "openapi": "pnpm --filter @pupitre/api openapi",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@pupitre/lint": "workspace:*",
    "@pupitre/shared": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "10.13.0",
    "ldapjs": "3.0.7",
    "typescript": "^7.0.2"
  }
}
